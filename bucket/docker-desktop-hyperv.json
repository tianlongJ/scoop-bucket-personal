{
    "homepage": "https://www.docker.com/products/docker-desktop/",
    "description": "The #1 containerization software for developers and teams",
    "version": "4.87.0",
    "license": "Unknown",
    "url": "https://desktop.docker.com/win/main/amd64/Docker Desktop Installer.exe",
    "hash": "9ac03d4e900c0fdee981d4bde083a55fdfb28ffba2cae77726eff2a437254822",
    "installer": {
        "script": [
            "$installation = \"$original_dir\\docker\"",
            "$hyperV = \"$persist_dir\\data\\hyper-v\"",
            "$windowsContainers = \"$persist_dir\\data\\windows-containers\"",
            "$wsl = \"$persist_dir\\data\\wsl\"",
            " Start-Process \"$dir\\Docker Desktop Installer.exe\" -Wait -ArgumentList 'install', '--accept-license', `",
            "    \"--installation-dir=$installation\", `",
            "    \"--always-run-service\", `",
            "    \"--backend=hyper-v\", `",
            "    \"--hyper-v-default-data-root=$hyperV\", `",
            "    \"--windows-containers-default-data-root=$windowsContainers\", `",
            "    \"--wsl-default-data-root=$wsl\""
        ]
    },
     "pre_install": [
        "if (!(is_admin)) {",
        "    error \"Administrator rights are required to install $app.\"",
        "    scoop uninstall $app",
        "    exit 1",
        "}",

        "$dockerDirs = @(",
        "    @{ source = \"$env:USERPROFILE\\.docker\"; target = \"$persist_dir\\config\\userprofile\\.docker\" },",
        "    @{ source = \"$env:LOCALAPPDATA\\Docker\"; target = \"$persist_dir\\config\\localappdata\\Docker\" },",
        "    @{ source = \"$env:APPDATA\\Docker\"; target = \"$persist_dir\\config\\appdata\\Docker\" }",
        ")",

        "foreach ($item in $dockerDirs) {",
        "    if (!(Test-Path $item.target)) {",
        "        New-Item -ItemType Directory -Path $item.target -Force | Out-Null",
        "    }",

        "    if (Test-Path $item.source) {",
        "        if (!(Get-Item $item.source).LinkType) {",
        "            Copy-Item \"$($item.source)\\*\" $item.target -Recurse -Force -ErrorAction SilentlyContinue",
        "            Remove-Item $item.source -Recurse -Force",
        "        }",
        "    }",

        "    if (!(Test-Path $item.source)) {",
        "        New-Item -ItemType Junction -Path $item.source -Target $item.target | Out-Null",
        "    }",
        "}"
    ],
    "pre_uninstall": [
        "if (!(is_admin)) {",
        "    error \"Administrator rights are required to uninstall $app.\"",
        "    exit 1",
        "}",

        "info 'Shutting down Docker Desktop...'",
        "& \"$dir\\docker\\DockerCli.exe\" -Shutdown",

        "info 'Uninstalling Docker Desktop...'",
        "Start-Process \"$dir\\docker\\Docker Desktop Installer.exe\" -Wait -ArgumentList 'uninstall', '--quiet', \"--installation-dir=$dir\\docker\"",

        "Remove-Item -LiteralPath \"$env:USERPROFILE\\.docker\" -Force -Recurse",
        "Remove-Item -LiteralPath \"$env:LOCALAPPDATA\\Docker\" -Force -Recurse",
        "Remove-Item -LiteralPath \"$env:APPDATA\\Docker\" -Force -Recurse"
    ],
    "env_add_path": "docker\\resources\\bin",
    "checkver": {
        "url": "https://docs.docker.com/desktop/release-notes/",
        "regex": "(?<version>[\\d.]+)</a></h2>[\\s\\S]*?https://desktop.docker.com/win/main/amd64/(?<id>[\\d.]+)/Docker%20Desktop%20Installer.exe"
    },
    "autoupdate": {
        "url": "https://desktop.docker.com/win/main/amd64/$matchId/Docker Desktop Installer.exe",
        "hash": {
            "url": "https://desktop.docker.com/win/main/amd64/$matchId/checksums.txt"
        }
    }
}
