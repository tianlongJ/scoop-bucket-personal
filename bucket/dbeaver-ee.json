{
  "version": "26.2.0",
  "description": "Database tool for developers, SQL programmers, database administrators and analysts",
  "homepage": "https://dbeaver.com",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://downloads.dbeaver.net/enterprise/26.2.0/dbeaver-ee-26.2.0-windows-x86_64.zip",
      "hash": "646cb0af3fddec5f40fc4062178e340b371a9285ad308ec95e9cac422bebef53"
    }
  },
  "persist": [
    "dbeaver.ini"
  ],
  "installer": {
    "script": [
      "ensure \"$persist_dir\" | Out-Null",
      "New-Item \"$env:APPDATA\\DBeaverData\" -ItemType Junction -Target \"$persist_dir\" | Out-Null"
    ]
  },
  "uninstaller": {
    "script":[
      "Remove-Item \"$env:APPDATA\\DBeaverData\" -Recurse -Force -ErrorAction 'SilentlyContinue'"
    ]
  },
  "extract_dir": "dbeaver",
  "bin": [
    "dbeaver.exe",
    "dbeaverc.exe"
  ],
  "shortcuts": [
    [
      "dbeaver.exe",
      "DBeaverEE"
    ]
  ],
  "checkver": {
    "github": "https://github.com/dbeaver/dbeaver"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://downloads.dbeaver.net/enterprise/$version/dbeaver-ee-$version-windows-x86_64.zip"
      }
    },
    "hash": {
      "url": "$baseurl/checksum/$basename.sha256"
    }
  }
}