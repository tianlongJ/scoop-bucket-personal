{
  "version": "26.1.0",
  "description": "Database tool for developers, SQL programmers, database administrators and analysts",
  "homepage": "https://dbeaver.com",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://downloads.dbeaver.net/enterprise/26.1.0/dbeaver-ee-26.1.0-windows-x86_64.zip",
      "hash": "f2e7ffc3c70471c9badfe56be2d9d0571b5ea729d38f30c85faf7f291e48a850"
    }
  },
  "persist": [
    "dbeaver.ini"
  ],
  "installer": {
    "script": [
      "ensure \"$persist_dir\" | Out-Null",
      "New-Item \"$env:APPDATA\\DBeaverData\" -ItemType Junction -Target \"$persist_dir\" | Out-Null"
    ]
  },
  "uninstaller": {
    "script":[
      "Remove-Item \"$env:APPDATA\\DBeaverData\" -Recurse -Force -ErrorAction 'SilentlyContinue'"
    ]
  },
  "extract_dir": "dbeaver",
  "bin": [
    "dbeaver.exe",
    "dbeaverc.exe"
  ],
  "shortcuts": [
    [
      "dbeaver.exe",
      "DBeaverEE"
    ]
  ],
  "checkver": {
    "github": "https://github.com/dbeaver/dbeaver"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://downloads.dbeaver.net/enterprise/$version/dbeaver-ee-$version-win32.win32.x86_64.zip"
      }
    },
    "hash": {
      "url": "$baseurl/checksum/$basename.sha256"
    }
  }
}